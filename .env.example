# Userbot settings. The setup and the Settings menu change this file for you;
# you can also edit it by hand (restart the bot afterwards).
# (Developers running from the repository: copy .env.example to .env.)
#
# Get these from https://my.telegram.org -> "API development tools"
# (e.g. API_ID=1234567, API_HASH=32 characters of 0-9 and a-f).
# Treat them like passwords: never commit or share the real file.
API_ID=
API_HASH=

# Optional: your phone number in international format. If left empty,
# you will be asked for it the first time you log in.
PHONE=

# Optional: name of the session file created in sessions/ (default: userbot).
SESSION_NAME=userbot

# Optional: prefix for your commands, e.g. ".ping" (default: ".").
COMMAND_PREFIX=.

# Optional: DEBUG, INFO, WARNING, ERROR (default: INFO).
LOG_LEVEL=INFO

# --- Auto-reply -------------------------------------------------------------
# Replies to messages people send you in private chats (not groups/channels).
AUTO_REPLY_ENABLED=true
# Fixed reply, used when the AI is off, not allowed for the chat, or fails.
AUTO_REPLY_TEXT=brate radim
# Seconds to wait for the person to stop sending messages, then reply once.
# 0 = reply to each message immediately.
AUTO_REPLY_DELAY=3
# Minimum seconds between auto-replies in the same chat. 0 = no limit.
AUTO_REPLY_COOLDOWN=0
# true = quote their message above each reply; false = plain message (more natural).
AUTO_REPLY_QUOTE=false

# --- Local AI (Ollama) --------------------------------------------------------
# Let a local LLM write the replies. Needs the Ollama app running and the model
# downloaded (the setup or the AI model menu does both). Falls back to
# AUTO_REPLY_TEXT if unavailable.
LLM_ENABLED=true
LLM_MODEL=qwen3.5:9b
LLM_HOST=http://localhost:11434
# The AI's instructions: a plain text file sent to the model as-is.
# Relative to the data folder. Switch and edit them in the Prompts menu.
#   prompts/chat.txt = holds a conversation as you (default)
#   prompts/busy.txt = says you're busy and will reply later
LLM_SYSTEM_PROMPT_FILE=prompts/chat.txt
# How many recent messages of the chat the AI sees.
LLM_HISTORY_LIMIT=20
# Seconds to wait for the AI before sending AUTO_REPLY_TEXT instead.
LLM_TIMEOUT=60
# Comma-separated chat IDs that get AI replies (find them with `.id`).
# Empty = everyone; other chats get AUTO_REPLY_TEXT.
LLM_ALLOWED_CHATS=
# Force replies into one language, e.g. English. Empty = whatever the prompt says.
# (The prompt alone isn't reliable: small models copy the chat's language.)
LLM_REPLY_LANGUAGE=English
